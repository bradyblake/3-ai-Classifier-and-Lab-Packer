# AI API Configuration for Document Parsing
# ===========================================
# Copy this file to .env and add your actual API keys

# Groq API (Fast LLM inference)
# Get your free API key from: https://console.groq.com
# Free tier: 14,400 requests per day
# Models available: mixtral-8x7b-32768, llama2-70b-4096, gemma-7b-it
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API (Advanced language understanding)
# Get your free API key from: https://makersuite.google.com/app/apikey
# Free tier: 15 requests per minute, 1500 requests per day
# Model used: gemini-pro
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API (if you want to add ChatGPT integration)
# Get API key from: https://platform.openai.com/api-keys
# Note: This is a paid service, not included in current implementation
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
# ===========================================

# Enable/disable AI features (true/false)
VITE_ENABLE_AI_PARSING=true

# Fallback behavior when AI APIs are unavailable
# Options: 'regex' (use pattern matching) or 'none' (fail gracefully)
VITE_FALLBACK_METHOD=regex

# Debug mode for AI responses (true/false)
VITE_AI_DEBUG_MODE=false

# Rate limiting settings (milliseconds between API calls)
VITE_API_RATE_LIMIT=1000

# Firebase Configuration
# ===========================================
# Get your Firebase config from: https://console.firebase.google.com/
# Create a new project or use existing project settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Features
VITE_ENABLE_FIREBASE_SYNC=true
VITE_ENABLE_FIREBASE_STORAGE=true

# ===========================================
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Replace "your_groq_api_key_here" with your actual Groq API key
# 3. Replace "your_gemini_api_key_here" with your actual Gemini API key
# 4. Save the .env file
# 5. Restart your development server (npm run dev)
#
# The .env file is ignored by Git to keep your API keys secure.
# Never commit your actual .env file with real API keys!
# ===========================================